<div class="window" style="margin: auto;">
    <div class="window-header">
        <span>Gerenciar Cartinhas</span>
        <a href="/admin" style="text-decoration: none; color: var(--retro-header-text); font-size: 11px; float: right;">[ Voltar ao Painel ]</a>
    </div>
    
    <div class="window-content">
        <aside style="padding: 5px; border: 1px dashed #808080; background: #ffffcc; font-size: 11px;">
            <b>Info:</b> As imagens são transicionadas a cada 10s. A proporção é 4/1. 
        </aside>

        <div style="margin-top: 10px; display: flex; flex-direction: column; gap: 10px;">
            <div>
                <strong>Filtrar Status:</strong>
                <select id="statusFilter" style="width: 100%; box-sizing: border-box; padding: 4px;">
                    <option value="">Todas as mensagens</option>
                    <option value="naolida">Não lidas</option>
                    <option value="lida">Lidas</option>
                    <option value="favorita">Favoritas</option>
                </select>
            </div>
            
            <div>
                <strong>Buscar Usuário:</strong>
                <input type="text" id="searchInput" placeholder="Nome do usuário..." style="width: 100%; box-sizing: border-box; padding: 4px;">
            </div>
            
            <div style="text-align: right; margin-top: 5px;">
                <button id="refreshBtn" style="padding: 4px 10px;">Buscar</button>
            </div>
        </div>
        
        <br>
        
        <div style="height: 350px; overflow-y: auto;">
            <div id="usuariosList">
                <div style="text-align: center; color: gray; padding: 20px;">Carregando...</div>
            </div>
        </div>
        
        <div id="pagination" style="text-align: center; margin-top: 10px;"></div>
    </div>
</div>

<dialog id="cartinhasModal" class="window" style="padding: 0; width: 600px; max-width: 95vw; box-sizing: border-box; margin: auto;">
    <div class="window-header">
        <span id="modalTitle">Cartinhas do Usuário</span>
        <button type="button" class="window-btn" onclick="document.getElementById('cartinhasModal').close()" style="float: right;">[ Fechar ]</button>
    </div>
    
    <div class="window-content">
        <div style="display: flex; gap: 5px; margin-bottom: 10px;">
            <select id="modalStatusFilter" style="flex: 1; padding: 4px;">
                <option value="">Status: Todos</option>
                <option value="naolida">Não lidas</option>
                <option value="lida">Lidas</option>
                <option value="favorita">Favoritas</option>
            </select>
            <input type="text" id="modalSearch" placeholder="Buscar por remetente..." style="flex: 2; padding: 4px;">
        </div>
        
        <div style="border: 2px inset var(--retro-border-dark); height: 300px; overflow-y: auto; padding: 5px;" id="cartinhasList">
        </div>
        
        <div id="modalPagination" style="margin-top: 10px; text-align: center;"></div>

        <div style="margin-top: 15px; text-align: center;">
            <button id="deleteSelectedBtn" style="color: #cc0000; font-weight: bold; padding: 5px 10px;" disabled>Excluir Selecionadas</button>
        </div>
    </div>
</dialog>

<script>
    let currentPage = 1;
    let currentModalPage = 1;
    let currentUserId = null;
    let currentUsername = null;
    let selectedCartinhas = new Set();
    let searchTimeout = null;

    const ITEMS_PER_PAGE = 20;
    const CARTINHAS_PER_PAGE = 15;

    document.addEventListener('DOMContentLoaded', () => {
        carregarUsuarios();

        document.getElementById('statusFilter').addEventListener('change', aplicarFiltros);
        document.getElementById('searchInput').addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(aplicarFiltros, 500);
        });
        document.getElementById('refreshBtn').addEventListener('click', carregarUsuarios);

        document.getElementById('modalStatusFilter').addEventListener('change', () => {
            currentModalPage = 1;
            carregarCartinhasUsuario();
        });
        document.getElementById('modalSearch').addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                currentModalPage = 1;
                carregarCartinhasUsuario();
            }, 500);
        });
        document.getElementById('deleteSelectedBtn').addEventListener('click', confirmarRemocaoSelecionadas);
    });

    async function carregarUsuarios() {
        try {
            document.getElementById('usuariosList').innerHTML = '<div style="text-align: center; padding: 20px; color: gray;">Carregando...</div>';
            
            const status = document.getElementById('statusFilter').value;
            const search = document.getElementById('searchInput').value.trim();
            const params = new URLSearchParams({ page: currentPage, limit: ITEMS_PER_PAGE });
            if (status) params.append('status', status);
            if (search) params.append('search', search);

            const response = await fetch(`/api/admin/cartinhas/usuarios?${params.toString()}`, { credentials: 'include' });
            if (!response.ok) throw new Error('Erro ao carregar');

            const data = await response.json();
            renderizarUsuarios(data.usuarios || []);
            renderizarPaginacao(data.currentPage, data.totalPages, 'pagination');
        } catch (error) {
            alert('Erro ao carregar usuários');
        }
    }

    async function carregarCartinhasUsuario() {
        if (!currentUserId) return;
        try {
            const status = document.getElementById('modalStatusFilter').value;
            const search = document.getElementById('modalSearch').value.trim();
            const params = new URLSearchParams({ page: currentModalPage, limit: CARTINHAS_PER_PAGE });
            if (status) params.append('status', status);
            if (search) params.append('search', search);

            const response = await fetch(`/api/admin/cartinhas/usuario/${currentUserId}?${params.toString()}`, { credentials: 'include' });
            if (!response.ok) throw new Error('Erro ao carregar');

            const data = await response.json();
            renderizarCartinhas(data.cartinhas);
            renderizarPaginacao(data.currentPage, data.totalPages, 'modalPagination');
        } catch (error) {
            alert('Erro ao carregar cartinhas do usuário');
        }
    }

    function renderizarUsuarios(usuarios) {
        const container = document.getElementById('usuariosList');
        if (usuarios.length === 0) {
            container.innerHTML = '<div style="text-align: center; padding: 20px; color: gray;">Nenhum usuário encontrado</div>';
            return;
        }

        container.innerHTML = usuarios.map(u => `
            <div style="border-bottom: 1px dashed var(--retro-border-dark); padding: 5px; cursor: pointer; display: flex; align-items: center; justify-content: space-between;" onclick="abrirCartinhasUsuario('${u.publicid}', '${u.username}')">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <img src="${u.profileimage || '/images/default-avatar.webp'}" style="width: 32px; height: 32px; border: 1px solid var(--retro-border-dark);">
                    <div>
                        <strong>${u.username}</strong><br>
                        <small style="color: gray;">Total: ${u.totalcartinhas}</small>
                    </div>
                </div>
                <div style="font-size: 11px; text-align: right;">
                    <span style="background: #ffcc00; padding: 1px 4px; border: 1px inset; margin-left: 2px;">NL: ${u.naolidas}</span> 
                    <span style="background: #00cc00; color: white; padding: 1px 4px; border: 1px inset; margin-left: 2px;">L: ${u.lidas}</span> 
                    <span style="background: #0099ff; color: white; padding: 1px 4px; border: 1px inset; margin-left: 2px;">F: ${u.favoritas}</span>
                </div>
            </div>
        `).join('');
    }

    function renderizarCartinhas(cartinhas) {
        const container = document.getElementById('cartinhasList');
        if (!cartinhas || cartinhas.length === 0) {
            container.innerHTML = '<div style="padding: 20px; text-align: center; color: gray;">Nenhuma cartinha encontrada</div>';
            return;
        }

        container.innerHTML = cartinhas.map(c => {
            const isSelected = selectedCartinhas.has(c.publicid);
            const bgColor = isSelected ? 'rgba(0, 0, 128, 0.1)' : 'transparent';

            let statusBadge = '';
            if (c.isfavorited) statusBadge = '<span style="font-size: 10px; background: #ffffd0; color: #808000; border: 1px outset; padding: 0 4px; font-weight: bold;">FAV</span>';
            else if (c.isread) statusBadge = '<span style="font-size: 10px; background: #e0e0e0; color: #666; border: 1px inset; padding: 0 4px;">LIDA</span>';
            else statusBadge = '<span style="font-size: 10px; background: #fff; color: #000080; border: 2px outset; padding: 0 4px; font-weight: bold;">NOVA</span>';

            const dataStr = c.createdat ? new Date(c.createdat).toLocaleString('pt-BR') : '-';
            const remetente = c.remetente?.username || 'Ex-membro';
            const destinatario = c.destinatario?.username || 'Ex-membro';

            return `
            <div style="display: flex; align-items: center; border-bottom: 1px dashed var(--retro-border-dark); padding: 5px; background: ${bgColor};">
                <input type="checkbox" ${isSelected ? 'checked' : ''} onchange="toggleSelecaoCartinha(this, '${c.publicid}')" style="margin-right: 10px;">
                
                <div style="flex: 1; min-width: 0;">
                    <div style="font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        <strong style="color: #800000;">${remetente}</strong> &rarr; <strong style="color: #000080;">${destinatario}</strong>
                    </div>
                    <div style="font-size: 11px; color: gray;">Enviada: ${dataStr}</div>
                </div>
                
                <div style="margin: 0 5px;">${statusBadge}</div>
                
                <button onclick="confirmarRemocaoUnica('${c.publicid}')" style="font-size: 10px; color: #cc0000; padding: 2px 4px;">Excluir</button>
            </div>
            `;
        }).join('');
    }

    function renderizarPaginacao(currentPage, totalPages, containerId) {
        const container = document.getElementById(containerId);
        if (totalPages <= 1) { container.innerHTML = ''; return; }

        let html = `<button ${currentPage === 1 ? 'disabled' : ''} onclick="mudarPagina(${currentPage - 1}, '${containerId}')">&laquo;</button> `;
        for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
            html += `<button ${i === currentPage ? 'disabled style="font-weight: bold;"' : ''} onclick="mudarPagina(${i}, '${containerId}')">${i}</button> `;
        }
        html += `<button ${currentPage === totalPages ? 'disabled' : ''} onclick="mudarPagina(${currentPage + 1}, '${containerId}')">&raquo;</button>`;
        container.innerHTML = html;
    }

    function abrirCartinhasUsuario(userId, username) {
        currentUserId = userId;
        currentUsername = username;
        currentModalPage = 1;
        selectedCartinhas.clear();
        document.getElementById('deleteSelectedBtn').disabled = true;
        document.getElementById('deleteSelectedBtn').textContent = 'Excluir Selecionadas';
        document.getElementById('modalTitle').textContent = `Cartinhas de ${username}`;
        carregarCartinhasUsuario();
        document.getElementById('cartinhasModal').showModal();
    }

    function toggleSelecaoCartinha(checkbox, cartinhaId) {
        if (checkbox.checked) selectedCartinhas.add(cartinhaId);
        else selectedCartinhas.delete(cartinhaId);

        checkbox.closest('div').style.background = checkbox.checked ? 'rgba(0, 0, 128, 0.1)' : 'transparent';

        const btn = document.getElementById('deleteSelectedBtn');
        btn.disabled = selectedCartinhas.size === 0;
        btn.textContent = selectedCartinhas.size > 0 ? `Excluir (${selectedCartinhas.size})` : 'Excluir Selecionadas';
    }

    async function confirmarRemocaoUnica(id) {
        let conf = typeof mostrarConfirmacao !== 'undefined'
            ? await mostrarConfirmacao('Remover cartinha permanentemente?', 'Excluir')
            : await confirm('Deseja remover esta cartinha?');
        if (conf) removerCartinhas([id]);
    }

    async function confirmarRemocaoSelecionadas() {
        if (selectedCartinhas.size === 0) return;
        let conf = typeof mostrarConfirmacao !== 'undefined'
            ? await mostrarConfirmacao(`Remover ${selectedCartinhas.size} cartinhas permanentemente?`, 'Excluir Selecionadas')
            : await confirm(`Remover ${selectedCartinhas.size} cartinhas?`);
        if (conf) removerCartinhas(Array.from(selectedCartinhas));
    }

    async function removerCartinhas(cartinhaIds) {
        try {
            const response = await fetch('/api/admin/cartinhas/remover', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ cartinhaIds })
            });
            if (response.ok) {
                selectedCartinhas.clear();
                document.getElementById('deleteSelectedBtn').disabled = true;
                document.getElementById('deleteSelectedBtn').textContent = 'Excluir Selecionadas';
                carregarCartinhasUsuario();
                carregarUsuarios(); 
            } else {
                alert('Erro ao remover');
            }
        } catch (error) {
            alert('Erro de conexão ao remover');
        }
    }

    function aplicarFiltros() { currentPage = 1; carregarUsuarios(); }
    
    function mudarPagina(p, id) {
        if (id === 'pagination') { currentPage = p; carregarUsuarios(); }
        else { currentModalPage = p; carregarCartinhasUsuario(); }
    }
</script>
