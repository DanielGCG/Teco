<div class="window">
    <div class="window-header">
        <span>Editar Termos e Privacidade</span>
        <a href="/admin" style="text-decoration: none; color: var(--retro-header-text); font-size: 11px;">[ Voltar ao Painel ]</a>
    </div>
    <div class="window-content">
        <p>
            Aqui você pode editar os Termos de Uso e a Política de Privacidade do Teco. <br>
            <strong>Ao clicar em "Salvar e Exigir Re-consentimento", todos os usuários logados serão deslogados ou bloqueados até aceitarem a nova versão.</strong>
        </p>

        <form id="termos-form">
            <fieldset style="margin-bottom: 15px;">
                <legend>Termos de Uso:</legend>
                <textarea id="terms_text" rows="10" style="width: 100%; box-sizing: border-box; resize: vertical;"></textarea>
            </fieldset>

            <fieldset style="margin-bottom: 15px;">
                <legend>Política de Privacidade:</legend>
                <textarea id="privacy_text" rows="10" style="width: 100%; box-sizing: border-box; resize: vertical;"></textarea>
            </fieldset>

            <p>
                <strong>Versão Atual de Consentimento:</strong> <span id="current_version_display">Carregando...</span><br>
                <span style="font-size: 11px; color: gray;">Aumentar esta versão fará com que todos precisem aceitar novamente.</span>
            </p>

            <div id="message" style="margin-bottom: 15px; font-weight: bold;"></div>

            <div style="display: flex; gap: 10px;">
                <button type="button" id="btn-save-only" class="window-btn" style="flex: 1; padding: 10px; font-weight: bold;">
                    Apenas Salvar Textos (Sem exigir)
                </button>
                <button type="button" id="btn-save-require" class="window-btn" style="flex: 1; padding: 10px; font-weight: bold; color: red;">
                    Salvar e Exigir Re-consentimento
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let currentVersion = 0;

    async function loadData() {
        try {
            const res = await fetch('/api/admin/config/legal-document');
            if (res.ok) {
                const data = await res.json();
                document.getElementById('terms_text').value = data.termsText || '';
                document.getElementById('privacy_text').value = data.privacyText || '';
                currentVersion = data.version || 0;
                document.getElementById('current_version_display').textContent = currentVersion === 0 ? 'Nenhum termo cadastrado' : currentVersion;
            } else {
                document.getElementById('current_version_display').textContent = 'Erro ao carregar';
            }
        } catch (err) {
            console.error('Erro ao carregar dados:', err);
        }
    }

    async function handleSave(incrementVersion) {
        const termsText = document.getElementById('terms_text').value;
        const privacyText = document.getElementById('privacy_text').value;
        const msgDiv = document.getElementById('message');

        msgDiv.textContent = 'Salvando...';
        msgDiv.style.color = 'var(--retro-link)';

        try {
            const res = await fetch('/api/admin/config/legal-document', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ termsText, privacyText, incrementVersion })
            });

            if (res.ok) {
                const data = await res.json();
                currentVersion = data.version;
                document.getElementById('current_version_display').textContent = currentVersion;
                msgDiv.textContent = 'Salvo com sucesso!';
                msgDiv.style.color = 'var(--retro-header-bg)';
            } else {
                msgDiv.textContent = 'Erro ao salvar.';
                msgDiv.style.color = 'var(--retro-link-hover)';
            }
        } catch (err) {
            console.error(err);
            msgDiv.textContent = 'Erro de rede ao salvar.';
            msgDiv.style.color = 'var(--retro-link-hover)';
        }
    }

    document.getElementById('btn-save-only').addEventListener('click', () => handleSave(false));
    
    document.getElementById('btn-save-require').addEventListener('click', async () => {
        if (await confirm("Tem certeza que deseja exigir o re-consentimento? Isso afetará todos os usuários ativos.")) {
            handleSave(true);
        }
    });

    loadData();
</script>
