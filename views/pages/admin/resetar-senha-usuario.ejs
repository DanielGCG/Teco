<div class="window" style="margin: auto;">
    <div class="window-header">
        <span>Redefinir Senha</span>
        <a href="/admin" style="text-decoration: none; color: var(--retro-header-text); font-size: 11px;">[ Voltar ao Painel ]</a>
    </div>
    <div class="window-content">
        <div style="margin-bottom: 10px;">
            <strong>Lista de Usuários no Sistema:</strong>
        </div>

        <div style="border-top: 2px inset var(--retro-border-dark); padding: 10px; display: flex; flex-direction: column; gap: 10px;">
            <fieldset>
                <legend>Selecione o usuário alvo:</legend>
                <select id="selectUser" style="width: 100%; box-sizing: border-box; padding: 4px; font-size: 14px;">
                    <option value="">Carregando usuários...</option>
                </select>
            </fieldset>
            
            <div style="padding-top: 5px; text-align: center;">
                <button id="resetBtn"
                    style="width: 100%; padding: 8px; font-weight: bold; color: #cc0000; border: 2px outset var(--retro-border-light);">
                    [ ! ] Resetar senha para 12345
                </button>
            </div>
            
            <hr style="margin: 10px 0; border: 1px dashed var(--retro-border-dark);">
            
            <fieldset>
                <legend>Alterar E-mail do usuário:</legend>
                <div style="display: flex; gap: 5px;">
                    <input type="email" id="newEmail" placeholder="Novo e-mail do usuário..." style="flex-grow: 1; padding: 4px; font-size: 14px; box-sizing: border-box;">
                </div>
            </fieldset>
            <div style="padding-top: 5px; text-align: center;">
                <button id="updateEmailBtn"
                    style="width: 100%; padding: 8px; font-weight: bold; border: 2px outset var(--retro-border-light);">
                    Alterar E-mail
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let usuariosLista = [];
    let currentLoggedUser = null;

    // ==================== Buscar usuário logado ====================
    async function buscarUsuarioLogado() {
        try {
            const res = await fetch('/api/users/me', { credentials: "include" });
            if (res.ok) {
                currentLoggedUser = await res.json();
            }
        } catch (err) {
            console.error("Erro ao buscar usuário logado:", err);
        }
    }

    // ==================== Carregar usuários ====================
    async function carregarUsuarios() {
        try {
            const res = await fetch('/api/admin/users', { credentials: "include" });
            if (!res.ok) throw new Error("Erro ao carregar usuários");

            usuariosLista = await res.json();

            const select = document.getElementById("selectUser");
            select.innerHTML = "";

            usuariosLista.forEach(u => {
                // Filtrar usuários: se não for Dono, não mostrar usuários de nível igual ou superior
                if (currentLoggedUser && currentLoggedUser.roleId > 1 && u.roleId <= currentLoggedUser.roleId) {
                    return; // Pula este usuário
                }

                const option = document.createElement("option");
                option.value = u.publicid;
                const roleNames = { 1: 'Dono', 5: 'Admin', 10: 'Mod', 11: 'Boteco', 20: 'Usuário' };
                const roleText = roleNames[u.roleId] || 'Usuário';
                option.textContent = `${u.username} (${roleText})`;
                select.appendChild(option);
            });
        } catch (err) {
            console.error(err);
            await alert("Erro ao carregar usuários");
        }
    }

    // ==================== Resetar senha ====================
    document.getElementById("resetBtn").addEventListener("click", async () => {
        const select = document.getElementById("selectUser");
        const userId = select.value;

        if (!userId) {
            return await alert("Selecione um usuário");
        }

        let confirmado = await confirm("Tem certeza que deseja resetar a senha para 12345?");

        if (!confirmado) return;

        try {
            const res = await fetch(`/api/admin/users/${userId}/reset-password`, {
                method: "PUT",
                credentials: "include"
            });

            const data = await res.json();
            if (res.ok) {
                await alert("Senha resetada com sucesso!");
                select.value = "";
            } else {
                await alert("Erro: " + data.message);
            }
        } catch (err) {
            console.error(err);
            await alert("Erro ao resetar senha");
        }
    });

    // ==================== Alterar E-mail ====================
    document.getElementById("updateEmailBtn").addEventListener("click", async () => {
        const select = document.getElementById("selectUser");
        const userId = select.value;
        const newEmail = document.getElementById("newEmail").value;

        if (!userId) {
            return await alert("Selecione um usuário");
        }
        
        if (!newEmail || !newEmail.includes('@')) {
            return await alert("Insira um e-mail válido");
        }

        let confirmado = await confirm(`Tem certeza que deseja alterar o e-mail deste usuário para ${newEmail}?`);

        if (!confirmado) return;

        try {
            const res = await fetch(`/api/admin/users/${userId}/update-email`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ newEmail }),
                credentials: "include"
            });

            const data = await res.json();
            if (res.ok) {
                await alert("E-mail atualizado com sucesso!");
                document.getElementById("newEmail").value = "";
            } else {
                await alert("Erro: " + data.message);
            }
        } catch (err) {
            console.error(err);
            await alert("Erro ao alterar e-mail");
        }
    });

    // ==================== Inicialização ====================
    window.addEventListener("DOMContentLoaded", async () => {
        await buscarUsuarioLogado();
        carregarUsuarios();
    });
</script>
