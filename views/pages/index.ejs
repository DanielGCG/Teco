<style>
    .desktop-hub {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
        padding: 10px 0;
    }

    .hub-window {
        margin: 0;
        display: flex;
        flex-direction: column;
    }

    .hub-btn {
        width: 100%;
        padding: 14px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
    }

    .hub-content {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background-color: transparent;
    }

    /* Estilos do carrossel */
    .index-carousel {
        position: relative;
        aspect-ratio: 4 / 1;
        border: 2px inset var(--retro-border-dark);
        background: black;
        overflow: hidden;
        cursor: pointer;
    }

    /* ----- Animações ----- */
    @keyframes panDown {
        0% { object-position: 50% 0%; transform: scale(1.05); }
        100% { object-position: 50% 100%; transform: scale(1.05); }
    }
    @keyframes panUp {
        0% { object-position: 50% 100%; transform: scale(1.05); }
        100% { object-position: 50% 0%; transform: scale(1.05); }
    }
    @keyframes zoomIn {
        0% { transform: scale(1); object-position: 50% 50%; }
        100% { transform: scale(1.15); object-position: 50% 50%; }
    }
    @keyframes zoomOut {
        0% { transform: scale(1.15); object-position: 50% 50%; }
        100% { transform: scale(1); object-position: 50% 50%; }
    }

    .index-carousel img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        -webkit-user-drag: none;
        user-select: none;
        z-index: 1;
    }

    .index-carousel img.active {
        z-index: 2;
    }
    
    .index-carousel img.exit {
        z-index: 1;
    }

    /* ----- Estilos de Transição ----- */
    /* 1. TransFade: fade suave */
    .index-carousel img.trans-fade {
        transition: opacity 0.5s ease-in-out;
    }
    .index-carousel img.trans-fade.active { opacity: 1; }

    /* 2. TransBlur: Desfoca e foca */
    .index-carousel img.trans-blur {
        transition: opacity 0.5s ease-in-out, filter 0.5s ease-in-out;
    }
    .index-carousel img.trans-blur:not(.active) { filter: blur(20px); }
    .index-carousel img.trans-blur.active { opacity: 1; filter: blur(0); }

    /* 3. TransFlash: Clarão de luz */
    .index-carousel img.trans-flash {
        transition: opacity 0.5s ease-in-out, filter 0.5s ease-in-out;
    }
    .index-carousel img.trans-flash:not(.active) { filter: brightness(5) contrast(2); }
    .index-carousel img.trans-flash.active { opacity: 1; filter: brightness(1) contrast(1); }


    /* Mantêm tanto na entrada (active) quanto na saída */
    .index-carousel img.anim-pan-down.active, .index-carousel img.anim-pan-down.exit {
        animation: panDown 10s linear forwards;
    }
    .index-carousel img.anim-pan-up.active, .index-carousel img.anim-pan-up.exit {
        animation: panUp 10s linear forwards;
    }
    .index-carousel img.anim-zoom-in.active, .index-carousel img.anim-zoom-in.exit {
        animation: zoomIn 10s linear forwards;
    }
    .index-carousel img.anim-zoom-out.active, .index-carousel img.anim-zoom-out.exit {
        animation: zoomOut 10s linear forwards;
    }
</style>

<% if (locals.indexCarousel && locals.indexCarousel.length> 0) { %>
    <div class="index-carousel" id="main-carousel">
        <% locals.indexCarousel.forEach(function(item, idx) { %>
            <img draggable="false" src="<%= item.imageUrl %>" data-link="<%= item.linkUrl || '' %>"
                class="<%= idx === 0 ? 'active' : '' %>" alt="Banner <%= idx+1 %>">
            <% }); %>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const carousel = document.getElementById('main-carousel');
            if (!carousel) return;
            const images = carousel.querySelectorAll('img');
            if (images.length === 0) return;

            let currentIndex = 0;
            let intervalId = null;
            let startX = 0;
            let endX = 0;
            const animations = ['anim-pan-down', 'anim-pan-up', 'anim-zoom-in', 'anim-zoom-out'];
            const transitions = ['trans-fade', 'trans-blur', 'trans-flash'];

            // Inicia a primeira imagem com efeitos aleatórios
            images[0].classList.add(
                animations[Math.floor(Math.random() * animations.length)],
                transitions[Math.floor(Math.random() * transitions.length)]
            );

            function showImage(index) {
                const currentImg = images[currentIndex];
                currentImg.classList.remove('active');
                currentImg.classList.add('exit');

                // Remove a classe exit e as classes de efeito depois do fade (0.5s)
                setTimeout(() => {
                    if (!currentImg.classList.contains('active')) {
                        currentImg.classList.remove('exit', ...animations, ...transitions);
                    }
                }, 500);

                currentIndex = (index + images.length) % images.length;
                const nextImg = images[currentIndex];
                
                // Escolhe os próximos efeitos
                const randomAnim = animations[Math.floor(Math.random() * animations.length)];
                const randomTrans = transitions[Math.floor(Math.random() * transitions.length)];
                
                nextImg.classList.remove('exit', ...animations, ...transitions);
                nextImg.classList.add('active', randomAnim, randomTrans);
            }

            function nextImage() { showImage(currentIndex + 1); }
            function prevImage() { showImage(currentIndex - 1); }

            function startInterval() {
                if (images.length <= 1) return;
                clearInterval(intervalId);
                intervalId = setInterval(nextImage, 10000);
            }
            startInterval();

            // Swipes (Touch & Mouse)
            let isSwiping = false;

            carousel.addEventListener('mousedown', e => { startX = e.clientX; isSwiping = false; });
            carousel.addEventListener('touchstart', e => { startX = e.changedTouches[0].clientX; isSwiping = false; }, { passive: true });

            function handleSwipeEnd(currentX) {
                endX = currentX;
                const diff = endX - startX;
                if (Math.abs(diff) > 30) {
                    isSwiping = true;
                    if (diff > 0) prevImage();
                    else nextImage();
                    startInterval();
                }
            }

            carousel.addEventListener('mouseup', e => { handleSwipeEnd(e.clientX); });
            carousel.addEventListener('touchend', e => { handleSwipeEnd(e.changedTouches[0].clientX); });

            carousel.addEventListener('click', (e) => {
                // Se foi um arrasto
                if (isSwiping) {
                    e.preventDefault();
                    return;
                }

                // Se não foi arrasto, verificar clique nas laterais ou centro
                const rect = carousel.getBoundingClientRect();
                const clickX = e.clientX - rect.left;

                if (clickX < rect.width * 0.25) {
                    prevImage();
                    startInterval();
                } else if (clickX > rect.width * 0.75) {
                    nextImage();
                    startInterval();
                } else {
                    // Clique no centro -> Abrir link ou a própria imagem
                    const currentImg = images[currentIndex];
                    const link = currentImg.getAttribute('data-link');
                    if (link && link.trim() !== '') {
                        window.location.href = link;
                    } else {
                        window.open(currentImg.src, '_blank');
                    }
                }
            });
        });
    </script>
    <% } %>

        <section class="desktop-hub">

            <!-- Janela: Social -->
