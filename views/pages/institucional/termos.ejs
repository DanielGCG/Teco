<div class="window" style="max-width: 800px; margin: 40px auto; box-shadow: 5px 5px 15px rgba(0,0,0,0.5);">
    <div class="window-header">
        <span>Termos de Uso</span>
    </div>
    <div class="window-content" style="padding: 30px;">
        <h1 style="color: var(--retro-text); border-bottom: 2px dashed var(--retro-border-dark); padding-bottom: 10px; margin-bottom: 20px;">Termos de Uso</h1>
        
        <div style="color: var(--retro-text); line-height: 1.6; font-size: 14px; white-space: pre-wrap;"><%= locals.termsText %></div>
        
        <div style="margin-top: 30px; text-align: center;">
            <a href="/" style="display: inline-block; padding: 5px 15px; background: var(--retro-window-bg); border-top: 2px solid var(--retro-border-light); border-left: 2px solid var(--retro-border-light); border-bottom: 2px solid var(--retro-border-dark); border-right: 2px solid var(--retro-border-dark); color: var(--retro-text); text-decoration: none; font-weight: bold; font-size: 12px; cursor: pointer;">
                Voltar
            </a>
        </div>
    </div>
</div>
