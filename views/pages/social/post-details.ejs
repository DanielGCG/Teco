<article class="window">
    <header class="window-header">
        <span>Visualizar Post</span>
        <nav style="float: right;">
            <a href="/" style="color: white; text-decoration: none; font-size: 10px;">[Voltar]</a>
        </nav>
    </header>
    <section class="window-content" id="retro-post-details">
        <p style="text-align: center;">Carregando post...</p>
    </section>
</article>

<article class="window" id="retro-comment-box" style="display: none;">
    <section class="window-content">
        <fieldset>
            <legend>Responder a este post</legend>
            <textarea id="comment-textarea" style="width: 100%; height: 60px; box-sizing: border-box; display: block;" placeholder="Escreva sua resposta..."></textarea>
            <div id="comment-media-preview" style="display: flex; gap: 5px; margin-top: 5px; flex-wrap: wrap;"></div>
            <footer style="margin-top: 5px; display: flex; justify-content: space-between; align-items: center; gap: 10px;">
                <div style="flex-grow: 1; display: flex; gap: 5px; align-items: center;">
                    <label for="comment-media-input" style="cursor: pointer; display: inline-block;">
                        <button type="button" onclick="document.getElementById('comment-media-input').click()" class="btn-sm">MÍDIA</button>
                    </label>
                    <input type="file" id="comment-media-input" multiple accept="image/*,video/*" style="display: none;">
                    
                    <button type="button" class="btn-sm" id="btn-rodinha-toggle-comment" onclick="RetroPosts.openRodinhaModal()" style="border-color: red; color: red;">RODINHA</button>
                </div>
                <button class="btn-bold" style="padding: 2px 20px;" id="btn-enviar-comentario">POSTAR</button>
            </footer>
            <div id="comment-upload-progress-container" style="display: none; margin-top: 5px; width: 100%; height: 10px; border: 1px solid var(--retro-border-dark); background: #eee;">
                <div id="comment-upload-progress-bar" style="width: 0%; height: 100%; background: var(--retro-header-bg); transition: width 0.1s;"></div>
            </div>
        </fieldset>
    </section>
</article>

<article class="window">
    <header class="window-header">Comentários e Respostas</header>
    <section class="window-content" id="retro-comments-list">
        <!-- Comentários aqui -->
    </section>
</article>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const postId = "<%= locals.postId %>";
        let selectedCommentFiles = [];

        // Inicializar Handlers Globais do Posts Retrô
        RetroPosts.initHandlers(() => carregarPost());

        async function carregarPost() {
            try {
                const res = await fetch(`/api/posts/${postId}`);
                if (!res.ok) throw new Error('Falha ao carregar');
                const post = await res.json();
                
                document.getElementById('retro-comment-box').style.display = 'block';

                if (post.isrodinha) {
                    const btnCommentRodinha = document.getElementById('btn-rodinha-toggle-comment');
                    if (btnCommentRodinha) {
                        btnCommentRodinha.style.display = 'none';
                    }
                }

                renderPostDetails(post);
                carregarComentarios();
            } catch (e) {
                document.getElementById('retro-post-details').innerHTML = '<p style="color:red;">Erro ao localizar post.</p>';
            }
        }

        function renderPostDetails(post) {  
            const currentUsername = "<%= locals.loggedUser ? locals.loggedUser.username : '' %>";
            const currentUserRole = parseInt("<%= locals.loggedUser ? locals.loggedUser.roleId : 20 %>");
            document.getElementById('retro-post-details').innerHTML = RetroPosts.renderPost(post, currentUsername, currentUserRole);
        }

        async function carregarComentarios() {
            try {
                const res = await fetch(`/api/posts/${postId}/replies`);
                const replies = await res.json();
                const container = document.getElementById('retro-comments-list');
                container.innerHTML = '';

                if (replies.length === 0) {
                    container.innerHTML = '<p style="text-align: center; color: #808080;">Ninguém comentou ainda. Seja o primeiro!</p>';
                    return;
                }

                const currentUsername = "<%= locals.loggedUser ? locals.loggedUser.username : '' %>";
                const currentUserRole = parseInt("<%= locals.loggedUser ? locals.loggedUser.roleId : 20 %>");
                replies.forEach(r => {
                    container.insertAdjacentHTML('beforeend', RetroPosts.renderPost(r, currentUsername, currentUserRole));
                });
            } catch (e) { console.error(e); }
        }

        window.handleRetroDelete = async (targetId) => {
            const confirmed = await confirm('Tem certeza que deseja apagar esta mensagem?', 'Confirmar Exclusão');
            if (!confirmed) return;

            try {
                const res = await fetch(`/api/posts/${targetId}`, { method: 'DELETE' });
                if (res.ok) {
                    if (targetId === postId) {
                        await alert('Post principal deletado. Voltando...');
                        window.history.back();
                    } else {
                        const el = document.getElementById(`post-${targetId}`);
                        if (el) el.style.display = 'none';
                    }
                }
            } catch (e) { console.error(e); }
        };

        RetroPosts.setupNewPost({
            textareaId: 'comment-textarea',
            mediaInputId: 'comment-media-input',
            previewId: 'comment-media-preview',
            btnPostarId: 'btn-enviar-comentario',
            progressContainerId: 'comment-upload-progress-container',
            progressBarId: 'comment-upload-progress-bar',
            callbackReload: carregarPost,
            extraFormData: {
                type: 'comment',
                attachedPostPublicId: postId
            }
        });

        carregarPost();
    });
</script>

<!-- Modal da Rodinha -->
<article class="window" id="modal-rodinha" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; width: 350px; max-width: calc(100vw - 40px);">
    <header class="window-header">
        Configurar Rodinha
        <button type="button" class="btn-sm" style="float: right;" onclick="RetroPosts.closeRodinhaModal()">X</button>
    </header>
    <section class="window-content">
        <label style="display: flex; align-items: center; gap: 5px; margin-bottom: 15px; font-weight: bold; font-size: 11px;">
            <input type="checkbox" id="rodinha-post-toggle" onchange="RetroPosts.toggleRodinhaState()"> Ligar modo Rodinha para este post
        </label>
        
        <p style="font-size: 11px;">Selecione usuários que você segue para a Rodinha:</p>
        <div id="rodinha-contacts-list" style="max-height: 200px; overflow-y: auto; border: 1px inset var(--retro-border-dark); padding: 5px; background: #fff; margin-bottom: 10px;">
            Carregando...
        </div>
        <div style="text-align: right;">
            <button type="button" class="btn-bold" onclick="RetroPosts.saveRodinha()">SALVAR</button>
        </div>
    </section>
</article>
<!-- Overlay do Modal -->
<div id="modal-rodinha-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999;" onclick="RetroPosts.closeRodinhaModal()"></div>
